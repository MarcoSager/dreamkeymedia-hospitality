{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreamkeymedia-hospitality",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
